# syntax=docker/dockerfile:1.7
# Build from this checkout; no AFFiNE release artifacts or registry publishing.
FROM node:22.23.2-bookworm AS build
WORKDIR /src
RUN apt-get update && apt-get install -y --no-install-recommends clang cmake libssl-dev \
    && rm -rf /var/lib/apt/lists/*
COPY rust-toolchain.toml ./
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal \
    --default-toolchain "$(awk -F '"' '/^channel/{print $2}' rust-toolchain.toml)"
ENV PATH="/root/.cargo/bin:${PATH}" \
    HUSKY=0 PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 ELECTRON_SKIP_BINARY_DOWNLOAD=1 \
    SENTRYCLI_SKIP_DOWNLOAD=1 BUILD_TYPE=canary NODE_OPTIONS=--max-old-space-size=8192 \
    CARGO_INCREMENTAL=0 CC=clang CFLAGS=-D_BSD_SOURCE AFFINE_SERVER_NATIVE_SINGLE_ARCH=1
# Bound compilation on personal Docker hosts that also run other services.
ARG CARGO_BUILD_JOBS=2
ARG CARGO_PROFILE_RELEASE_LTO=false
ARG CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16
RUN corepack enable
COPY . .
RUN --mount=type=cache,target=/root/.yarn/berry/cache yarn install --immutable
ARG AFFINE_PRO_PUBLIC_KEY
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/src/target \
    AFFINE_PRO_PUBLIC_KEY="${AFFINE_PRO_PUBLIC_KEY:-$(cat .docker/selfhost/community-build-public-key.pem)}" \
    yarn workspace @affine/server-native build
ARG VCS_REF=unknown
ENV GITHUB_SHA=${VCS_REF} PUBLIC_PATH=/
RUN yarn affine @affine/web build && test -s packages/frontend/apps/web/dist/selfhost.html \
    && yarn affine @affine/admin build && test -s packages/frontend/admin/dist/selfhost.html \
    && yarn affine @affine/mobile build && test -s packages/frontend/apps/mobile/dist/selfhost.html \
    && yarn workspace @affine/server build && test -s packages/backend/server/dist/main.js
# Match the normal release packaging, with production dependencies resolved for
# the actual target architecture instead of copying the host's node_modules.
RUN --mount=type=cache,target=/root/.yarn/berry/cache \
    yarn workspaces focus @affine/server --production \
    && yarn workspace @affine/server prisma generate \
    && mv node_modules packages/backend/server/node_modules
RUN mkdir -p /app/static \
    && cp -a packages/backend/server/. /app/ \
    && cp -a packages/frontend/apps/web/dist/. /app/static/ \
    && cp -a packages/frontend/admin/dist /app/static/admin \
    && cp -a packages/frontend/apps/mobile/dist /app/static/mobile
ARG TARGETARCH
RUN AFFINE_DOCKER_CLEAN=1 TARGETARCH="${TARGETARCH}" APP_ROOT=/app node /app/scripts/docker-clean.mjs

FROM node:22.23.2-bookworm-slim AS runtime
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl libjemalloc2 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /app /app
ARG VCS_REF=unknown
LABEL org.opencontainers.image.revision="${VCS_REF}" org.opencontainers.image.title="AFFiNE with optional personal ChatGPT connections"
ENV LD_PRELOAD=libjemalloc.so.2
EXPOSE 3010
CMD ["sh", "-c", "node ./scripts/upgrade-config.js && exec node ./dist/main.js"]
